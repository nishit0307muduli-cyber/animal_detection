# Backend & heavy assets – exclude from Vercel upload\n../backend/\n../backend/**/*\n../backend/yolov8*.pt        # model weights\n../backend/outputs/\n../backend/uploads/\n../.venv/\n../main.py\n../requirements.txt\n../bootstrap_and_start.ps1\n../run_all.bat\n../setup.bat\n../start.bat\n\n# Development helpers – not needed on Vercel\n*.ps1\n*.bat\n\n# Large node_modules – Vercel will reinstall\nnode_modules/\n\n# Optional large artefacts (images, videos) – ignore if not required\n*.png\n*.webp\n*.jpg\n*.jpeg\n*.gif\n*.mp4\n*.avi\n
